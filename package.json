{
  "name": "simaufstand-2000",
  "version": "0.1.0",
  "private": true,
  "description": "SimAufstand 2000 – satirische isometrische Browser-Strategie: Polizei gegen Demonstranten",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
